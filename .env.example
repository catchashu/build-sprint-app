# PostHog public project token only (phc_...), never a personal/admin API key.
# Leave blank until consent and event/recording privacy have been reviewed.
VITE_POSTHOG_PROJECT_TOKEN=
# This project uses PostHog's EU ingestion region.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Exact "true" opts in, production builds only. Keep false for this first step.
# Events, replay and automatic errors remain blocked pending separate approval.
VITE_POSTHOG_ENABLED=false
